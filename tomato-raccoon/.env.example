# URL of the YNS instance
YNS_API_KEY=your_api_token_here
NEXT_PUBLIC_YNS_API_TENANT=optional_api_base_url

# ==========================================
# 🖨️ Printify POD 自动化履约配置
# ==========================================
# 在 Printify 后台: My Profile -> API -> Generate API Token
PRINTIFY_API_TOKEN=your_printify_api_token_here
# Printify 店铺 ID (在当前 URL 或 API 中获取, 如 29674533)
PRINTIFY_SHOP_ID=29674533

# ==========================================
# 💳 独立站跨境收单网关 (Stripe / Airwallex)
# ==========================================
# Stripe 信用卡 / Apple Pay 支付密钥
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 或 空中云汇 (Airwallex) 国内合规收单
AIRWALLEX_API_KEY=your_airwallex_key
AIRWALLEX_CLIENT_ID=your_client_id

